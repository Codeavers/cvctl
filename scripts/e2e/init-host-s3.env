CVCTL_EDGE_MODE=behind-proxy
CVCTL_PROXY_PORT=8081
CVCTL_SSH_MANAGE=false
CVCTL_FIREWALL_MANAGE=false
CVCTL_STORAGE=s3
CVCTL_S3_ENDPOINT=http://S3_IP_PLACEHOLDER:9000
CVCTL_S3_BUCKET=cvctl-e2e
CVCTL_S3_REGION=us-east-1
CVCTL_NOTIFY=none
CVCTL_ADMIN_USER=runner
CVCTL_HOST_NAME=e2e
CVCTL_REGISTRIES=ghcr.io/example
